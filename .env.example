# ── 슬랙 (권장: Incoming Webhook) ──────────────────────────────
# https://api.slack.com/apps → Create New App → Incoming Webhooks → Add New Webhook
SLACK_WEBHOOK_URL=

# 뉴스만 다른 채널로 받고 싶으면 여기에 (비우면 위 기본 웹훅으로 감)
SLACK_WEBHOOK_NEWS=

# ── 웹훅 대신 로그인된 크롬으로 보낼 때만 ─────────────────────
# 크롬을 --remote-debugging-port=9222 로 띄워두고, 보낼 채널 URL을 넣는다
SLACK_NEWS_CHANNEL_URL=
