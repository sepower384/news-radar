# ── 슬랙 (권장: Incoming Webhook) ──────────────────────────────
# https://api.slack.com/apps → Create New App → Incoming Webhooks → Add New Webhook
SLACK_WEBHOOK_URL=

# 뉴스만 다른 채널로 받고 싶으면 여기에 (비우면 위 기본 웹훅으로 감)
SLACK_WEBHOOK_NEWS=

# ── 텔레그램 (슬랙과 동시 발송. 비우면 조용히 건너뜀) ──────────
# 봇 토큰: 이 스트림(📰 세력의 정보원) 전용 봇이 있으면 _NEWS 에. 없으면 공용 토큰을 쓴다
TELEGRAM_BOT_TOKEN_NEWS=
TELEGRAM_BOT_TOKEN=
# 슈퍼그룹 ID (-100 으로 시작)
TELEGRAM_CHAT_ID=
# 토픽(스레드) ID. 비우면 그룹 일반 대화방으로 간다
TELEGRAM_TOPIC_NEWS=

# ── 웹훅 대신 로그인된 크롬으로 보낼 때만 ─────────────────────
# 크롬을 --remote-debugging-port=9222 로 띄워두고, 보낼 채널 URL을 넣는다
SLACK_NEWS_CHANNEL_URL=
